---
import { Layout } from '@features/layout';
import { ForgeMock, Portfolio, ProjectsIntro } from '@features/projects';
import { Schema } from '@shared/components';
import { getLanguageStaticPaths, useI18n } from '@shared/helpers';
import { PROJECTS_I18N } from '@shared/i18n';
import type { WebPage } from 'schema-dts';

export const getStaticPaths = getLanguageStaticPaths;

const t = useI18n(Astro.url, PROJECTS_I18N);

const webJsonLd: WebPage = {
  '@type': 'WebPage',
  name: t('name'),
  mainEntity: [
    {
      '@type': 'CreativeWork',
      name: t('portfolio_name'),
      description: t('portfolio_description'),
    },
  ],
};
---

<Layout title={t('title')} description={t('description')}>
  <div class="mx-auto w-full max-w-6xl px-4 py-12">
    <ProjectsIntro />

    <Portfolio />

    <ForgeMock />
  </div>
</Layout>

<Schema jsonLd={webJsonLd} />
