---
import CallToAction from '@components/contacts/CallToAction.astro';
import ContactIntro from '@components/contacts/ContactIntro.astro';
import DirectContact from '@components/contacts/DirectContact.astro';
import SocialLinks from '@components/contacts/SocialLinks.astro';
import { Layout } from '@layout';
import { SOCIALS } from '@shared/constants';
import { getLanguageStaticPaths, useI18n } from '@shared/helpers';
import { SEO_I18N } from '@shared/i18n';
import type { Person } from 'schema-dts';

export const getStaticPaths = getLanguageStaticPaths;

const t = useI18n(Astro.url, SEO_I18N);

const personJsonLd: Person = {
  '@type': 'Person',
  name: t('name'),
  image: 'https://www.khavol.com/me.jpg',
  email: `mailto:${SOCIALS.EMAIL}`,
  sameAs: [SOCIALS.GITHUB, SOCIALS.LINKEDIN, SOCIALS.TELEGRAM],
  contactPoint: {
    '@type': 'ContactPoint',
    availableLanguage: ['en-US', 'uk-UA'],
  },
};
---

<Layout title={t('title')} description={t('description')}>
  <div class="mx-auto w-full max-w-6xl px-4 py-12">
    <ContactIntro />

    <DirectContact />

    <SocialLinks />

    <CallToAction />
  </div>
</Layout>
