---
import { BackButtons, NotFound } from '@components/not-found';
import { Layout } from '@layout';
import { useI18n } from '@shared/helpers';
import { NOT_FOUND_I18N } from '@shared/i18n';

const t = useI18n(Astro.url, NOT_FOUND_I18N);
---

<Layout title={t('title')} description={t('description')} noindex={true}>
  <div class="bg-base-100 my-8 flex min-h-[70vh] flex-col items-center justify-center text-center">
    <NotFound />

    <BackButtons />
  </div>
</Layout>
