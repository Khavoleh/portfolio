---
import LogoIcon from '@assets/logo.svg';
import { PAGE_URLS } from '@shared/constants';
import { getLanguageUrl, useI18n } from '@shared/helpers';
import type { NavLink } from '@shared/interfaces';
import { NAVIGATION_LINKS } from '../../constants';
import BurgerIcon from '../../icons/burger.svg';
import { NAVBAR_TRANSLATIONS } from '../../translations';
import LanguageSelector from './components/language-selector/LanguageSelector.astro';
import ThemeSelector from './components/ThemeSelector.astro';

const t = useI18n(Astro.url, NAVBAR_TRANSLATIONS);
const currentPath: string = Astro.url.pathname;
---

<header class="navbar border-base-300 bg-base-200 fixed start-0 top-0 z-100 border-b px-4">
  <div class="navbar-start">
    <label
      id="mobile-drawer-burger"
      for="mobile-drawer"
      class="btn btn-ghost btn-square focus-ring drawer-button md:hidden"
      aria-label={t('menu')}
      tabindex="0"
      onkeydown="if(event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); setTimeout(() => document.getElementById('drawer-close-btn')?.focus(), 100); }"
      onclick="setTimeout(() => document.getElementById('drawer-close-btn')?.focus(), 100);"
    >
      <BurgerIcon class="h-5 w-5" />
    </label>

    <a
      href={getLanguageUrl(Astro.url, PAGE_URLS.HOME)}
      aria-label="Navigate to home page"
      class="btn btn-ghost focus-ring hidden gap-2 px-2 md:flex"
    >
      <LogoIcon class="h-8" />
      <span class="text-xl font-semibold">{t('name')}</span>
    </a>

    <nav class="hidden md:flex">
      <ul class="menu menu-horizontal flex-nowrap gap-1 px-1 text-base">
        {
          NAVIGATION_LINKS.map((link: NavLink) => {
            const isActive: boolean = currentPath === getLanguageUrl(Astro.url, link.href);

            return (
              <li>
                <a
                  href={getLanguageUrl(Astro.url, link.href)}
                  class:list={['focus-ring px-4 py-2 whitespace-nowrap', isActive && 'active text-primary']}
                  aria-label={`${t('navigate.to')} ${t(link.label)} ${t('page')}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {t(link.label)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>

  <div class="navbar-end flex gap-4">
    <LanguageSelector />
    <ThemeSelector />

    <a
      href={getLanguageUrl(Astro.url, PAGE_URLS.HOME)}
      aria-label="Navigate to home page"
      class="btn btn-ghost focus-ring gap-2 px-2 md:hidden"
    >
      <span class="hidden text-xl font-semibold md:inline">{t('name')}</span>
      <LogoIcon class="h-8" />
    </a>
  </div>
</header>
