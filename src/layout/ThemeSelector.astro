---
import { useI18n } from '@shared/helpers';
import { NAVBAR_TRANSLATIONS } from 'src/layout/translations.ts';
import { THEMES } from './constants.ts';
import type { Theme } from './interfaces.ts';

interface Props {
  idSuffix: string;
}

const { idSuffix } = Astro.props;
const t = useI18n(Astro.url, NAVBAR_TRANSLATIONS);
---

<div class="dropdown dropdown-end">
  <button
    tabindex="0"
    type="button"
    class="btn btn-ghost btn-square focus-ring"
    aria-label={t('toggle.theme')}
    aria-haspopup="true"
  >
    {THEMES.map((theme: Theme) => <theme.icon id={`theme-icon-${theme.id}-${idSuffix}`} class="hidden h-6 w-6" />)}
  </button>

  <ul role="menu" class="dropdown-content menu rounded-box bg-base-200 z-50 mt-2 w-32 p-2 shadow-lg">
    {
      THEMES.map((theme: Theme) => (
        <li role="menuitem">
          <button
            type="button"
            data-set-theme={theme.id}
            class="text-base-content rounded-field hover:bg-base-300 active:bg-base-300 focus:bg-base-300 flex w-full cursor-pointer items-center gap-2 border-none bg-transparent px-3 py-1.5 text-left text-sm outline-none"
          >
            <theme.icon class="h-5 w-5" />
            <span>{t(theme.id)}</span>
          </button>
        </li>
      ))
    }
  </ul>
</div>
