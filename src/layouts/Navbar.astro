---
import { PAGE_URLS } from '@shared/constants.ts';
import type { NavLink } from '@shared/interfaces.ts';
import { getLanguageUrl, useTranslations } from '@shared/helpers.ts';
import LogoIcon from '@assets/logo.svg';
import { NAVIGATION_LINKS } from './constants.ts';
import { NAVBAR_TRANSLATIONS } from './translations.ts';
import BurgerIcon from './icons/burger.svg';
import ThemeSelector from './ThemeSelector.astro';
import LanguageSelector from './LanguageSelector.astro';

const t = useTranslations(Astro.url, NAVBAR_TRANSLATIONS);
const currentPath: string = Astro.url.pathname;
---

<header class="navbar border-base-300 bg-base-100 fixed start-0 top-0 z-100 border-b px-4">
  <div class="navbar-start">
    <button
      type="button"
      class="btn btn-ghost btn-square focus-ring md:hidden"
      aria-label={t('menu')}
      aria-expanded="false"
      aria-controls="mobile-drawer"
      onclick="document.getElementById('mobile-drawer').checked = true; setTimeout(() => document.getElementById('drawer-close-btn')?.focus(), 100);"
    >
      <BurgerIcon class="h-5 w-5" />
    </button>

    <a
      href={getLanguageUrl(Astro.url, PAGE_URLS.HOME)}
      aria-label="Navigate to home page"
      class="btn btn-ghost focus-ring hidden gap-2 px-2 md:flex"
    >
      <LogoIcon class="h-8" />
      <span class="text-xl font-semibold">{t('name')}</span>
    </a>

    <nav class="hidden md:flex">
      <ul class="menu menu-horizontal flex-nowrap gap-1 px-1 text-base">
        {
          NAVIGATION_LINKS.map((link: NavLink) => {
            const isActive: boolean = currentPath === getLanguageUrl(Astro.url, link.href);

            return (
              <li>
                <a
                  href={getLanguageUrl(Astro.url, link.href)}
                  class:list={['focus-ring px-4 py-2 whitespace-nowrap', isActive && 'active text-primary']}
                  aria-label={`${t('navigate.to')} ${t(link.label)} ${t('page')}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {t(link.label)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>

  <div class="navbar-end flex gap-4">
    <LanguageSelector idSuffix="desktop" />
    <ThemeSelector idSuffix="desktop" />

    <a
      href={getLanguageUrl(Astro.url, PAGE_URLS.HOME)}
      aria-label="Navigate to home page"
      class="btn btn-ghost focus-ring gap-2 px-2 md:hidden"
    >
      <span class="hidden text-xl font-semibold md:inline">{t('name')}</span>
      <LogoIcon class="h-8" />
    </a>
  </div>
</header>

<div class="drawer drawer-start md:hidden">
  <input id="mobile-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-side z-150">
    <label for="mobile-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
    <div id="drawer-content" class="menu bg-base-200 min-h-full w-80 p-4">
      <div class="mb-4 flex items-center justify-between">
        <span class="text-lg font-semibold">{t('menu')}</span>
        <button
          id="drawer-close-btn"
          type="button"
          class="btn btn-ghost btn-sm btn-circle focus-ring"
          aria-label={t('close')}
          onclick="document.getElementById('mobile-drawer').checked = false;"
        >
          ✕
        </button>
      </div>
      <ul class="space-y-1 text-lg">
        {
          NAVIGATION_LINKS.map((link: NavLink, index: number) => {
            const isActive: boolean = currentPath === getLanguageUrl(Astro.url, link.href);
            const isLast: boolean = index === NAVIGATION_LINKS.length - 1;

            return (
              <li>
                <a
                  href={getLanguageUrl(Astro.url, link.href)}
                  class:list={['focus-ring', isActive && 'active text-primary']}
                  aria-label={`${t('navigate.to')} ${t(link.label)} ${t('page')}`}
                  aria-current={isActive ? 'page' : undefined}
                  onkeydown={
                    isLast
                      ? "if(event.key === 'Tab' && !event.shiftKey) { event.preventDefault(); document.getElementById('drawer-close-btn')?.focus(); }"
                      : undefined
                  }
                >
                  {t(link.label)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</div>
