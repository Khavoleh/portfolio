---
import { getLanguageUrl, useTranslations } from '@shared/helpers.ts';
import type { NavLink } from '@shared/interfaces.ts';
import { NAVIGATION_LINKS } from './constants.ts';
import { NAVBAR_TRANSLATIONS } from './translations.ts';

const t = useTranslations(Astro.url, NAVBAR_TRANSLATIONS);
const currentPath: string = Astro.url.pathname;
---

<div class="drawer-side z-150">
  <label for="mobile-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
  <div class="menu bg-base-200 min-h-full w-80 p-4">
    <div class="mb-4 flex items-center justify-between">
      <span class="text-lg font-semibold">{t('menu')}</span>
      <label
        id="drawer-close-btn"
        for="mobile-drawer"
        class="btn btn-ghost btn-sm btn-circle focus-ring"
        aria-label={t('close')}
        tabindex="0"
        onkeydown="if(event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); } if(event.key === 'Tab' && event.shiftKey) { event.preventDefault(); document.querySelector('#drawer-nav-list a:last-of-type')?.focus(); }"
      >
        ✕
      </label>
    </div>
    <ul id="drawer-nav-list" class="space-y-1 text-lg">
      {
        NAVIGATION_LINKS.map((link: NavLink, index: number) => {
          const isActive: boolean = currentPath === getLanguageUrl(Astro.url, link.href);
          const isLast: boolean = index === NAVIGATION_LINKS.length - 1;

          return (
            <li>
              <a
                href={getLanguageUrl(Astro.url, link.href)}
                class:list={['focus-ring', isActive && 'active text-primary']}
                aria-label={`${t('navigate.to')} ${t(link.label)} ${t('page')}`}
                aria-current={isActive ? 'page' : undefined}
                onkeydown={
                  isLast
                    ? "if(event.key === 'Tab' && !event.shiftKey) { event.preventDefault(); document.getElementById('drawer-close-btn')?.focus(); }"
                    : undefined
                }
              >
                {t(link.label)}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>
