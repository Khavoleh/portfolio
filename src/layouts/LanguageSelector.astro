---
import { useTranslations } from '@shared/helpers.ts';
import { LANGUAGES_CONFIG } from './constants.ts';
import { getCurrentLang, getLanguageUrl } from './helpers.ts';
import type { Language } from './interfaces.ts';
import { LANGUAGE_TRANSLATIONS } from './translations.ts';

interface Props {
  idSuffix: string;
}

const { idSuffix } = Astro.props;
const currentLang = getCurrentLang(Astro.url);
const t = useTranslations(Astro.url, LANGUAGE_TRANSLATIONS);
---

<div class="dropdown dropdown-end">
  <button
    tabindex="0"
    type="button"
    class="btn btn-ghost btn-square focus-ring"
    aria-label={t('change_language')}
    aria-haspopup="true"
  >
    {
      LANGUAGES_CONFIG.map((lang: Language) => (
        <lang.icon
          id={`language-icon-${lang.code}-${idSuffix}`}
          class:list={['h-6 w-6', { hidden: lang.code !== currentLang }]}
        />
      ))
    }
  </button>

  <ul role="menu" class="dropdown-content menu rounded-box bg-base-200 z-50 mt-2 w-36 p-2 shadow-lg">
    {
      LANGUAGES_CONFIG.map((lang: Language) => (
        <li role="menuitem">
          <a href={getLanguageUrl(Astro.url, lang.code)} data-language={lang.code}>
            <lang.icon class="h-5 w-5" />
            <span>{lang.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
