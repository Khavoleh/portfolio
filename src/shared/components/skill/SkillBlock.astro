---
import { getStyleClasses } from './helpers/getStyleClasses';
import { getTextClasses } from './helpers/getTextClasses';
import type { Skill } from './skill';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;

const styleClasses: string = getStyleClasses(skill.type);
const textClasses: string = getTextClasses(skill.type);
---

<div class={`badge badge-lg gap-2 ${styleClasses}`}>
  <span class={`text-sm font-semibold ${textClasses}`}>{skill.name}</span>
</div>
