---
import { SOCIALS } from '@shared/constants';
import { useI18n } from '@shared/helpers';
import { CONTACT_SECTION_TRANSLATIONS } from './contact-section-translations';

const t = useI18n(Astro.url, CONTACT_SECTION_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('privacy.contact.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('privacy.contact.text1')} />
  <p class="text-base-content/80">
    <span set:html={t('privacy.contact.text2')} />
    <a
      href={`mailto:${SOCIALS.EMAIL}`}
      class="link link-primary focus-ring rounded font-semibold transition-all duration-200">{SOCIALS.EMAIL}</a
    >
  </p>
</section>
