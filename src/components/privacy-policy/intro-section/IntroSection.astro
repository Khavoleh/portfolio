---
import { useI18n } from '@shared/helpers';
import { INTRO_SECTION_I18N } from './intro-section-i18n';

const t = useI18n(Astro.url, INTRO_SECTION_I18N);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('privacy_intro_title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('privacy_intro_text')} />
</section>
