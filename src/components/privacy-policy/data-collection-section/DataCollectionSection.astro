---
import { useI18n } from '@shared/helpers';
import { DATA_COLLECTION_SECTION_I18N } from './data-collection-section-i18n';

const t = useI18n(Astro.url, DATA_COLLECTION_SECTION_I18N);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('privacy_collect_title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('privacy_collect_text1')} />
  <p class="text-base-content/80 mb-4" set:html={t('privacy_collect_text2')} />
  <ul class="text-base-content/80 mb-4 list-inside list-disc space-y-2">
    <li set:html={t('privacy_collect_technical')} />
    <li set:html={t('privacy_collect_usage')} />
    <li set:html={t('privacy_collect_local')} />
  </ul>
</section>
