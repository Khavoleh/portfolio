---
import { useI18n } from '@shared/helpers';
import { EXTERNAL_LINKS_SECTION_TRANSLATIONS } from './external-links-section-translations';

const t = useI18n(Astro.url, EXTERNAL_LINKS_SECTION_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('privacy.links.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('privacy.links.text')} />
</section>
