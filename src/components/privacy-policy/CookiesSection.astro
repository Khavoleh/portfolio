---
import { useTranslations } from '@shared/helpers';
import { PRIVACY_POLICY_TRANSLATIONS } from './translations.ts';

const t = useTranslations(Astro.url, PRIVACY_POLICY_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('privacy.cookies.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('privacy.cookies.text')} />
  <ul class="text-base-content/80 mb-4 list-inside list-disc space-y-2">
    <li set:html={t('privacy.cookies.local')} />
    <li set:html={t('privacy.cookies.no_cookies')} />
    <li set:html={t('privacy.cookies.no_ip')} />
    <li set:html={t('privacy.cookies.no_cross')} />
  </ul>
</section>
