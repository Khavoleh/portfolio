---
import { useTranslations } from '@shared/helpers/index';
import { PRIVACY_POLICY_TRANSLATIONS } from './translations.ts';

const t = useTranslations(Astro.url, PRIVACY_POLICY_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('privacy.collect.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('privacy.collect.text1')} />
  <p class="text-base-content/80 mb-4" set:html={t('privacy.collect.text2')} />
  <ul class="text-base-content/80 mb-4 list-inside list-disc space-y-2">
    <li set:html={t('privacy.collect.technical')} />
    <li set:html={t('privacy.collect.usage')} />
    <li set:html={t('privacy.collect.local')} />
  </ul>
</section>
