---
import { useI18n } from '@shared/helpers';
import { PRIVACY_POLICY_TRANSLATIONS } from './translations.ts';

const t = useI18n(Astro.url, PRIVACY_POLICY_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('privacy.use.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('privacy.use.text')} />
  <ul class="text-base-content/80 mb-4 list-inside list-disc space-y-2">
    <li set:html={t('privacy.use.monitor')} />
    <li set:html={t('privacy.use.detect')} />
    <li set:html={t('privacy.use.improve')} />
  </ul>
</section>
