---
import { Image } from 'astro:assets';
import type { Review } from './interfaces';

interface Props {
  review: Review;
}

const { review } = Astro.props;
---

<div class="card bg-base-200 border-base-300 h-full border shadow-md transition-shadow duration-200 hover:shadow-xl">
  <div class="card-body p-6">
    <div class="mb-4 flex items-start gap-4">
      <div class="avatar">
        <div class="w-12 rounded-full">
          <Image src={review.image} alt={review.name} width={48} height={48} />
        </div>
      </div>

      <div class="flex-1">
        <h3 class="text-base-content text-lg font-bold">{review.name}</h3>
        <p class="text-base-content/80 text-sm">
          {review.position}
        </p>
        <p class="text-base-content/80 text-sm font-semibold">{review.company}</p>
      </div>
    </div>

    <div class="scrollbar-styled flex-1 overflow-y-auto">
      <p class="text-base-content/90 leading-relaxed">
        {review.text}
      </p>
    </div>
  </div>
</div>
