---
import type { Metric } from './interfaces';

interface Props {
  metric: Metric;
}

const { metric } = Astro.props;
---

<div class="card bg-base-200 border-base-300 border shadow-lg">
  <div class="card-body items-center p-6 text-center">
    <div class="text-primary mb-2 text-4xl font-bold">{metric.value}</div>
    <div class="text-base-content mb-1 text-sm font-semibold">{metric.name}</div>
    <div class="text-base-content/70 text-sm">{metric.description}</div>
  </div>
</div>
