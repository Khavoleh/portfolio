---
import { useI18n } from '@shared/helpers';
import type { Metric } from './components/metric/interfaces';
import MetricBlock from './components/metric/MetricBlock.astro';
import { METRICS } from './constants';
import { METRICS_TRANSLATIONS } from './translations';

const t = useI18n(Astro.url, METRICS_TRANSLATIONS);

const translatedMetrics: Metric[] = METRICS.map((metric) => ({
  ...metric,
  name: t(metric.name),
  description: t(metric.description),
}));
---

<section class="mb-12">
  <h2 class="text-base-content mb-8 text-center text-2xl font-bold">{t('metrics.title')}</h2>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
    {translatedMetrics.map((metric: Metric) => <MetricBlock metric={metric} />)}
  </div>
</section>
