---
import ReviewCard from '@shared/review/ReviewCard.astro';
import { REVIEWS } from './constants';
import LinkIcon from './icons/link.svg';
import type { Review } from '@shared/review/interfaces.ts';
import { shuffleArray } from './helpers.ts';
import { useTranslations } from '@shared/helpers.ts';
import { REVIEWS_TRANSLATIONS } from './translations.ts';

const t = useTranslations(Astro.url, REVIEWS_TRANSLATIONS);

const translatedReviews: Review[] = REVIEWS.map((review) => ({
  ...review,
  name: t(review.name),
  position: t(review.position),
  text: t(review.text),
}));

const shuffledReviews: Review[] = shuffleArray(translatedReviews);
---

<section class="mt-12">
  <div class="mb-8 text-center">
    <h2 class="text-base-content mb-4 text-3xl font-bold">{t('reviews.title')}</h2>
    <p class="text-base-content mx-auto max-w-2xl text-lg">{t('reviews.subtitle')}</p>
  </div>

  <div class="mx-auto w-full max-w-4xl">
    <div class="carousel w-full" id="reviews-carousel">
      {
        shuffledReviews.map((review: Review, index: number) => {
          const prevIndex = index === 0 ? shuffledReviews.length - 1 : index - 1;
          const nextIndex = index === shuffledReviews.length - 1 ? 0 : index + 1;

          return (
            <div id={`review-${index}`} class="carousel-item relative w-full scroll-mx-0">
              <div class="w-full px-2">
                <ReviewCard review={review} />
              </div>
              <div class="absolute top-1/2 right-2 left-2 flex -translate-y-1/2 transform justify-between">
                <button
                  data-target={`review-${prevIndex}`}
                  class="btn btn-circle review-nav-btn focus-ring bg-base-100/50 hover:bg-base-100/80 border-none"
                  aria-label={t('reviews.button.previous')}
                >
                  ❮
                </button>
                <button
                  data-target={`review-${nextIndex}`}
                  class="btn btn-circle review-nav-btn focus-ring bg-base-100/50 hover:bg-base-100/80 border-none"
                  aria-label={t('reviews.button.next')}
                >
                  ❯
                </button>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <div class="mt-8 text-center">
    <a
      href="https://www.linkedin.com/in/khavol/"
      target="_blank"
      rel="noopener noreferrer"
      class="link link-primary focus-ring inline-flex items-center gap-2 rounded font-semibold transition-all duration-200"
    >
      {t('reviews.linkedin.link')}
      <LinkIcon class="h-4 w-4" />
    </a>
  </div>
</section>

<script>
  function initReviewsCarousel() {
    const navButtons = document.querySelectorAll('.review-nav-btn');

    navButtons.forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = (e.currentTarget as HTMLElement).dataset.target;

        if (targetId) {
          const targetElement = document.getElementById(targetId);

          if (targetElement) {
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
          }
        }
      });
    });
  }

  initReviewsCarousel();

  document.addEventListener('astro:page-load', initReviewsCarousel);
</script>
