---
import { getLanguageUrl, useTranslations } from '@shared/helpers.ts';
import { GOAL_TRANSLATIONS } from './translations.ts';
import { PAGE_URLS } from '@shared/constants.ts';

const t = useTranslations(Astro.url, GOAL_TRANSLATIONS);
---

<section class="text-center">
  <h2 class="text-base-content mb-4 text-3xl font-bold">{t('goal.title')}</h2>
  <p class="text-base-content mx-auto mb-8 max-w-3xl text-lg leading-relaxed" set:html={t('goal.description')} />

  <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
    <a
      href={getLanguageUrl(Astro.url, PAGE_URLS.EXPERIENCE)}
      class="btn btn-lg focus-ring bg-blue-600 text-white shadow-lg hover:bg-blue-700"
    >
      {t('goal.button.experience')}
    </a>

    <a
      href={getLanguageUrl(Astro.url, PAGE_URLS.PROJECTS)}
      class="btn btn-outline btn-primary btn-lg focus-ring shadow-lg"
    >
      {t('goal.button.projects')}
    </a>
  </div>
</section>
