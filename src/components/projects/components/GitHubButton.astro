---
import GitHubIcon from '@assets/github.svg';
import { useI18n } from '@shared/helpers';
import { PROJECT_COMPONENTS_TRANSLATIONS } from '../translations.ts';

interface Props {
  url: string;
}

const { url } = Astro.props;
const t = useI18n(Astro.url, PROJECT_COMPONENTS_TRANSLATIONS);
---

<div class="flex justify-center">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn-lg focus-ring bg-blue-600 text-white shadow-lg hover:bg-blue-700"
  >
    <GitHubIcon class="mr-2 h-6 w-6" fill="white" />
    {t('components.github.button')}
  </a>
</div>
