---
import { useI18n } from '@shared/helpers';
import { PROJECTS_INTRO_I18N } from './projects-intro-i18n';

const t = useI18n(Astro.url, PROJECTS_INTRO_I18N);
---

<section class="mb-12 text-center">
  <h1 class="text-primary mb-6 text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">
    {t('intro_title')}
  </h1>

  <p class="text-base-content mx-auto max-w-4xl text-lg leading-relaxed md:text-xl">
    {t('intro_description')}
  </p>
</section>
