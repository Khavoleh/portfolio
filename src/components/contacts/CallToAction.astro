---
import { PAGE_URLS } from '@shared/constants';
import { getLanguageUrl, useTranslations } from '@shared/helpers';
import ViewCv from '@shared/view-cv/ViewCv.astro';
import { CALL_TO_ACTION_TRANSLATIONS } from './translations.ts';

const t = useTranslations(Astro.url, CALL_TO_ACTION_TRANSLATIONS);
---

<section class="text-center">
  <h2 class="text-base-content mb-4 text-2xl font-bold">{t('cta.title')}</h2>
  <p class="text-base-content mx-auto mb-8 max-w-2xl leading-relaxed">
    {t('cta.description')}
  </p>

  <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
    <ViewCv />

    <a
      href={getLanguageUrl(Astro.url, PAGE_URLS.EXPERIENCE)}
      class="btn btn-outline btn-primary btn-lg focus-ring shadow-lg"
    >
      {t('cta.button.experience')}
    </a>
  </div>
</section>
