---
import { SOCIALS } from '@shared/constants/index';
import { useTranslations } from '@shared/helpers/index';
import { getUkraineTimezone } from './helpers';
import EmailIcon from './icons/email.svg';
import GeolocationIcon from './icons/geolocation.svg';
import MessengerIcon from './icons/messenger.svg';
import { DIRECT_CONTACT_TRANSLATIONS } from './translations.ts';

const iconClasses = 'mb-4 h-12 w-12 text-primary';
const contactInformationClasses =
  'card bg-base-200 border-base-300 flex flex-col items-center border p-6 text-center shadow-lg transition-transform duration-200 hover:scale-105 w-64';
const t = useTranslations(Astro.url, DIRECT_CONTACT_TRANSLATIONS);
---

<section class="mb-16">
  <h2 class="text-base-content mb-8 text-center text-3xl font-bold">{t('directContact.title')}</h2>

  <div class="mx-auto flex flex-wrap justify-center gap-6">
    <div class={contactInformationClasses}>
      <EmailIcon class={iconClasses} />
      <h3 class="text-base-content mb-2 text-xl font-semibold">{t('directContact.email.title')}</h3>
      <a href=`mailto:${SOCIALS.EMAIL}` class="link link-primary focus-ring rounded transition-all duration-200">
        {SOCIALS.EMAIL}
      </a>
    </div>

    <div class={contactInformationClasses}>
      <MessengerIcon class={iconClasses} />
      <h3 class="text-base-content mb-2 text-xl font-semibold">Telegram</h3>
      <a
        href={SOCIALS.TELEGRAM}
        target="_blank"
        rel="noopener noreferrer"
        class="link link-primary focus-ring rounded transition-all duration-200"
      >
        @khavol
      </a>
    </div>

    <div class={contactInformationClasses}>
      <GeolocationIcon class={iconClasses} />
      <h3 class="text-base-content mb-2 text-xl font-semibold">{t('directContact.location.title')}</h3>
      <p class="text-base-content/80">{t('directContact.location.city')}</p>
      <p class="text-base-content/70 text-sm">{getUkraineTimezone()}</p>
    </div>
  </div>
</section>
