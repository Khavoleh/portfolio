---
import { PAGE_URLS } from '@shared/constants';
import BackIcon from './icons/back.svg';
import HomeIcon from './icons/home.svg';
---

<section class="flex flex-col items-center justify-center gap-4 sm:flex-row">
  <a href={`/en${PAGE_URLS.HOME}`} class="btn btn-lg focus-ring bg-blue-600 text-white shadow-lg hover:bg-blue-700">
    <HomeIcon class="mr-2 h-5 w-5" />
    Back to Home
  </a>

  <button onclick="window.history.back()" class="btn btn-lg btn-outline btn-primary focus-ring shadow-lg">
    <BackIcon class="mr-2 h-5 w-5" />
    Go Back
  </button>
</section>
