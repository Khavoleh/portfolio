---
import type { Skill } from '@shared/components';
import { SkillBlock } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { EXPERIENCE_DATA } from './constants';
import type { ExperienceItem, ExperienceSection } from './interfaces';
import { EXPERIENCE_DATA_TRANSLATIONS } from './translations';

const t = useI18n(Astro.url, EXPERIENCE_DATA_TRANSLATIONS);
---

<div class="relative">
  {
    EXPERIENCE_DATA.map((experience: ExperienceItem) => (
      <div class="relative">
        <div class="bg-primary/70 absolute top-20 bottom-0 left-8 w-0.5 md:left-1/2 md:-ml-px" />

        <div class="absolute top-8 left-8 -ml-3 md:left-1/2 md:-ml-4">
          <div class="border-primary bg-base-100 h-6 w-6 rounded-full border-4 md:h-8 md:w-8" />
        </div>

        <div class="ml-24 md:ml-0 md:w-full">
          <div class="mb-16 md:grid md:grid-cols-2 md:gap-12">
            <div class="md:text-right">
              <div class="card bg-base-200 border-base-300 mb-6 border p-6 shadow-lg md:ml-auto md:max-w-lg">
                <div class="mb-3">
                  <h2 class="text-base-content mb-2 text-2xl font-bold">{t(experience.role)}</h2>
                  <p class="text-primary text-lg font-semibold">{t(experience.company)}</p>
                  <p class="text-base-content font-semibold">{t(experience.sector)}</p>
                  <p class="text-base-content/70 mt-1 text-sm">{t(experience.period)}</p>
                </div>

                <div class="flex flex-wrap justify-start gap-3 md:justify-end">
                  {experience.skills.map((skill: Skill) => (
                    <SkillBlock skill={skill} />
                  ))}
                </div>
              </div>
            </div>

            <div class="space-y-6">
              {experience.sections.map((section: ExperienceSection) => (
                <div class="card bg-base-200 border-base-300 border p-6 shadow-lg">
                  <h3 class="text-base-content mb-3 flex items-center text-xl font-bold">
                    <section.icon class="mr-2 shrink-0 text-2xl" />
                    {t(section.title)}
                  </h3>
                  <p class="text-base-content leading-relaxed font-medium">{t(section.details)}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>
