---
import { ViewCv } from '@shared/components';
import { PAGE_URLS } from '@shared/constants';
import { getLanguageUrl, useTranslations } from '@shared/helpers';
import { CALL_TO_ACTION_TRANSLATIONS } from './translations.ts';

const t = useTranslations(Astro.url, CALL_TO_ACTION_TRANSLATIONS);
---

<section class="mt-16 text-center">
  <h2 class="text-base-content mb-6 text-3xl font-bold">{t('cta.title')}</h2>

  <div class="flex flex-col items-center justify-center gap-4 md:flex-row">
    <ViewCv />

    <a
      href={getLanguageUrl(Astro.url, PAGE_URLS.PROJECTS)}
      class="btn btn-outline btn-primary btn-lg focus-ring shadow-lg"
    >
      {t('cta.button.projects')}
    </a>
  </div>
</section>
