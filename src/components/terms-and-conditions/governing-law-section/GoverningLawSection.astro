---
import { useI18n } from '@shared/helpers';
import { GOVERNING_LAW_SECTION_TRANSLATIONS } from './governing-law-section-translations';

const t = useI18n(Astro.url, GOVERNING_LAW_SECTION_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('terms.governing.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('terms.governing.text')} />
</section>
