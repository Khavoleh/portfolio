---
import { useI18n } from '@shared/helpers';
import { DISCLAIMERS_SECTION_I18N } from './disclaimers-section-i18n';

const t = useI18n(Astro.url, DISCLAIMERS_SECTION_I18N);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('terms.disclaimers.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('terms.disclaimers.text')} />
  <ul class="text-base-content/80 mb-4 list-inside list-disc space-y-2">
    <li set:html={t('terms.disclaimers.informational')} />
    <li set:html={t('terms.disclaimers.no_guarantee')} />
  </ul>
</section>
