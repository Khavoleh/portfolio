---
import { useTranslations } from '@shared/helpers.ts';
import { TERMS_AND_CONDITIONS_TRANSLATIONS } from './translations.ts';

const t = useTranslations(Astro.url, TERMS_AND_CONDITIONS_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('terms.intellectual.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('terms.intellectual.text')} />
  <ul class="text-base-content/80 mb-4 list-inside list-disc space-y-2">
    <li set:html={t('terms.intellectual.code')} />
    <li set:html={t('terms.intellectual.restrictions')} />
  </ul>
</section>
