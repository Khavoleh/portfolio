---
import { useI18n } from '@shared/helpers';
import { EXTERNAL_LINKS_SECTION_I18N } from './external-links-section-i18n';

const t = useI18n(Astro.url, EXTERNAL_LINKS_SECTION_I18N);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('terms_links_title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('terms_links_text1')} />
  <p class="text-base-content/80 mb-4" set:html={t('terms_links_text2')} />
</section>
