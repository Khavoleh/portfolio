---
import { SOCIALS } from '@shared/constants';
import { useTranslations } from '@shared/helpers.ts';
import { TERMS_AND_CONDITIONS_TRANSLATIONS } from './translations.ts';

const t = useTranslations(Astro.url, TERMS_AND_CONDITIONS_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('terms.contact.title')}</h2>
  <p class="text-base-content/80">
    <span set:html={t('terms.contact.text')} />
    <a
      href={`mailto:${SOCIALS.EMAIL}`}
      class="link link-primary focus-ring rounded font-semibold transition-all duration-200">{SOCIALS.EMAIL}</a
    >
  </p>
</section>
