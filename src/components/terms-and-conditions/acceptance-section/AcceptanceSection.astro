---
import { useI18n } from '@shared/helpers';
import { ACCEPTANCE_SECTION_TRANSLATIONS } from './acceptance-section-translations';

const t = useI18n(Astro.url, ACCEPTANCE_SECTION_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('terms.acceptance.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('terms.acceptance.text')} />
</section>
