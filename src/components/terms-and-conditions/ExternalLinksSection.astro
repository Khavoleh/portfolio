---
import { useI18n } from '@shared/helpers';
import { TERMS_AND_CONDITIONS_TRANSLATIONS } from './translations.ts';

const t = useI18n(Astro.url, TERMS_AND_CONDITIONS_TRANSLATIONS);
---

<section class="mb-8">
  <h2 class="text-base-content mb-4 text-2xl font-semibold">{t('terms.links.title')}</h2>
  <p class="text-base-content/80 mb-4" set:html={t('terms.links.text1')} />
  <p class="text-base-content/80 mb-4" set:html={t('terms.links.text2')} />
</section>
