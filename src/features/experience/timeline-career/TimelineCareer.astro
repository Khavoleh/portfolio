---
import { Card, Heading } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { SkillBlock } from '@widgets/skill';
import { EXPERIENCE_DATA } from './experience-data';
import { EXPERIENCE_DATA_I18N } from './experience-data-i18n';
import type { ExperienceItem } from './experience-item';

const t = useI18n(Astro.url, EXPERIENCE_DATA_I18N);
---

<div class="relative">
  {
    EXPERIENCE_DATA.map((experience: ExperienceItem) => (
      <div class="relative">
        <div class="bg-primary/70 absolute top-20 bottom-0 left-8 w-0.5 md:left-1/2 md:-ml-px" />

        <div class="absolute top-8 left-8 -ml-3 md:left-1/2 md:-ml-4">
          <div class="border-primary bg-base-100 h-6 w-6 rounded-full border-4 md:h-8 md:w-8" />
        </div>

        <div class="ml-24 md:ml-0 md:w-full">
          <div class="mb-16 md:grid md:grid-cols-2 md:gap-12">
            <div class="md:text-right">
              <Card class="mb-6 md:ml-auto md:max-w-lg">
                <div class="mb-3">
                  <Heading level={2} class="mb-2">
                    {t(experience.role)}
                  </Heading>
                  <p class="text-base-content text-lg font-semibold">{t(experience.company)}</p>
                  <p class="text-base-content font-semibold">{t(experience.sector)}</p>
                  <p class="text-base-content/80 mt-1 text-sm">{t(experience.period)}</p>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  {experience.skills.map((skill) => (
                    <SkillBlock skill={skill} />
                  ))}
                </div>
              </Card>
            </div>

            <div class="space-y-6">
              {experience.sections.map((section) => (
                <Card>
                  <Heading level={3} class="mb-3 flex items-center">
                    <section.icon class="mr-2 shrink-0 text-2xl" />
                    {t(section.title)}
                  </Heading>
                  <p class="text-base-content leading-relaxed font-medium">{t(section.details)}</p>
                </Card>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>
