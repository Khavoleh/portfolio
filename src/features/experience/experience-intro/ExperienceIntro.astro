---
import { useI18n } from '@shared/helpers';
import { EXPERIENCE_INTRO_I18N } from './experience-intro-i18n';

const t = useI18n(Astro.url, EXPERIENCE_INTRO_I18N);
---

<section class="mb-16 text-center">
  <h1 class="text-base-content mb-6 text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">
    <span class="text-primary">{t('intro_title')}</span>
  </h1>

  <p class="text-base-content mx-auto max-w-4xl text-lg leading-relaxed md:text-xl">
    {t('intro_description')}
  </p>
</section>
