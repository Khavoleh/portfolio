---
import { Button, Heading } from '@shared/components';
import { PAGE_URLS } from '@shared/constants';
import { getLanguageUrl, useI18n } from '@shared/helpers';
import { ViewCv } from '@widgets/view-cv';
import { CALL_TO_ACTION_I18N } from './call-to-action-i18n';

const t = useI18n(Astro.url, CALL_TO_ACTION_I18N);
---

<section class="mt-16 text-center">
  <Heading level={2} size="3xl" center class="mb-6">{t('cta_title')}</Heading>

  <div class="flex flex-col items-center justify-center gap-4 md:flex-row">
    <ViewCv />

    <Button href={getLanguageUrl(Astro.url, PAGE_URLS.PROJECTS)} variant="secondary" outline>
      {t('cta_button_projects')}
    </Button>
  </div>
</section>
