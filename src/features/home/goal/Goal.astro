---
import { Button, Heading, Prose } from '@shared/components';
import { PAGE_URLS } from '@shared/constants';
import { getLanguageUrl, useI18n } from '@shared/helpers';
import { GOAL_I18N } from './goal-i18n';

const t = useI18n(Astro.url, GOAL_I18N);
---

<section class="text-center">
  <Heading level={2} size="3xl" center class="mb-4">{t('goal_title')}</Heading>
  <Prose size="lg" center html={t('goal_description')} class="mx-auto mb-8 max-w-3xl" />

  <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
    <Button href={getLanguageUrl(Astro.url, PAGE_URLS.EXPERIENCE)}>
      {t('goal_button_experience')}
    </Button>

    <Button href={getLanguageUrl(Astro.url, PAGE_URLS.PROJECTS)} variant="secondary" outline>
      {t('goal_button_projects')}
    </Button>
  </div>
</section>
