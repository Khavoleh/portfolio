---
import { Heading } from '@shared/components';
import { useI18n } from '@shared/helpers';
import MetricBlock from './components/MetricBlock.astro';
import type { Metric } from './metric';
import { METRICS } from './metrics-data';
import { METRICS_I18N } from './metrics-i18n';

const t = useI18n(Astro.url, METRICS_I18N);

const translatedMetrics: Metric[] = METRICS.map((metric) => ({
  ...metric,
  name: t(metric.name),
  description: t(metric.description),
}));
---

<section class="mb-12">
  <Heading level={2} center class="mb-8">{t('metrics_title')}</Heading>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
    {translatedMetrics.map((metric: Metric) => <MetricBlock metric={metric} />)}
  </div>
</section>
