---
import { SOCIALS } from '@shared/constants';
import { useI18n } from '@shared/helpers';
import ReviewCard from './components/ReviewCard.astro';
import LinkIcon from './icons/link.svg';
import type { Review } from './review';
import { REVIEWS } from './reviews-data';
import { REVIEWS_I18N } from './reviews-i18n';
import { shuffleArray } from './shuffle-array';

const t = useI18n(Astro.url, REVIEWS_I18N);

const translatedReviews: Review[] = REVIEWS.map((review) => ({
  ...review,
  name: t(review.name),
  position: t(review.position),
  text: t(review.text),
}));

const shuffledReviews: Review[] = shuffleArray(translatedReviews);
---

<section class="mt-12">
  <div class="mb-8 text-center">
    <h2 class="text-base-content mb-4 text-3xl font-bold">{t('reviews_title')}</h2>
    <p class="text-base-content mx-auto max-w-2xl text-lg">{t('reviews_subtitle')}</p>
  </div>

  <div class="mx-auto w-full max-w-4xl">
    <div class="carousel w-full" id="reviews-carousel">
      {
        shuffledReviews.map((review: Review, index: number) => {
          const prevIndex = index === 0 ? shuffledReviews.length - 1 : index - 1;
          const nextIndex = index === shuffledReviews.length - 1 ? 0 : index + 1;

          return (
            <div id={`review-${index}`} class="carousel-item relative w-full scroll-mx-0">
              <div class="w-full px-2 lg:px-14">
                <ReviewCard review={review} />
              </div>
              <div class="absolute top-1/2 right-2 left-2 flex -translate-y-1/2 transform justify-between lg:right-1 lg:left-1">
                <button
                  data-target={`review-${prevIndex}`}
                  class="btn btn-circle review-nav-btn focus-ring max-lg:bg-base-100/50 max-lg:hover:bg-base-100/80 lg:btn-secondary lg:btn-outline shadow"
                  aria-label={t('reviews_button_previous')}
                >
                  ❮
                </button>
                <button
                  data-target={`review-${nextIndex}`}
                  class="btn btn-circle review-nav-btn focus-ring max-lg:bg-base-100/50 max-lg:hover:bg-base-100/80 lg:btn-secondary lg:btn-outline shadow"
                  aria-label={t('reviews_button_next')}
                >
                  ❯
                </button>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <div class="mt-8 text-center">
    <a
      href={SOCIALS.LINKEDIN}
      target="_blank"
      rel="noopener noreferrer"
      class="link link-violet focus-ring inline-flex items-center gap-2 rounded font-semibold"
      tabindex="0"
    >
      {t('reviews_linkedin_link')}
      <LinkIcon class="icon-muted h-4 w-4" />
    </a>
  </div>
</section>

<script>
  function initReviewsCarousel() {
    const navButtons = document.querySelectorAll('.review-nav-btn');

    navButtons.forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = (e.currentTarget as HTMLElement).dataset.target;

        if (targetId) {
          const targetElement = document.getElementById(targetId);

          if (targetElement) {
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
          }
        }
      });
    });
  }

  initReviewsCarousel();

  document.addEventListener('astro:page-load', initReviewsCarousel);
</script>
