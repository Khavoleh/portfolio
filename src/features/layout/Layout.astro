---
import './global.css';
import { ClientRouter } from 'astro:transitions';
import { getLanguageFromUrl } from '@shared/helpers';
import Footer from './components/footer/Footer.astro';
import Navbar from './components/navbar/Navbar.astro';
import Seo from './components/seo/Seo.astro';
import Sidebar from './components/sidebar/Sidebar.astro';
import removeTransitionsScript from './scripts/remove-transitions.js?raw';
import themeInitScript from './scripts/theme-init.js?raw';

export interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
const language = getLanguageFromUrl(Astro.url);
const fontScript = language === 'uk' ? 'cyrillic' : 'latin';
---

<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} noindex={noindex} />
    <link
      rel="preload"
      href={`/fonts/inter/inter-${fontScript}-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={`/fonts/lora/lora-${fontScript}.woff2`} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <script is:inline set:html={themeInitScript} />
    <script is:inline set:html={removeTransitionsScript} />
    <script
      async
      defer
      is:inline
      data-website-id="0a8086d4-feda-4293-a9f4-d11ba668ae6f"
      src="/umami-analytics.js"
      data-performance="true"></script>
  </head>
  <body class="bg-base-100 text-base-content transition-bg transition-colors">
    <div class="drawer">
      <input id="mobile-drawer" type="checkbox" class="drawer-toggle" hidden aria-hidden="true" tabindex="-1" />
      <div class="drawer-content flex min-h-screen flex-col">
        <Navbar />
        <main class="transition-bg grow pt-20 pb-2 transition-colors">
          <slot />
        </main>
        <Footer />
      </div>
      <Sidebar />
    </div>
  </body>
</html>
