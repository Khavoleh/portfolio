---
import { PAGE_URLS } from '@shared/constants';
import { getLanguageUrl, useI18n } from '@shared/helpers';
import type { SocialLink } from '@shared/interfaces';
import { FOOTER_I18N } from './footer-i18n';
import { SOCIAL_LINKS } from './social-links';

const t = useI18n(Astro.url, FOOTER_I18N);
const currentYear = new Date().getFullYear();
---

<footer class="border-base-300 bg-base-200 border-t">
  <div class="mx-auto flex w-full max-w-7xl flex-col items-center justify-between gap-4 p-4 md:flex-row lg:py-6">
    <span class="text-base-content/70 text-center text-sm md:text-left">
      © {currentYear}
      {t('copyright')}
    </span>

    <nav
      class="flex flex-wrap items-center justify-center gap-4 text-sm font-medium md:gap-6"
      aria-label={t('legal_links')}
    >
      <a
        href={getLanguageUrl(Astro.url, PAGE_URLS.PRIVACY_POLICY)}
        class="focus-ring text-base-content/70 hover:text-base-content rounded"
        tabindex="0"
      >
        {t('privacy_policy')}
      </a>
      <a
        href={getLanguageUrl(Astro.url, PAGE_URLS.TERMS_AND_CONDITIONS)}
        class="focus-ring text-base-content/70 hover:text-base-content rounded"
        tabindex="0"
      >
        {t('terms_and_conditions')}
      </a>
    </nav>

    <nav class="flex justify-center gap-5" aria-label={t('social_links')}>
      {
        SOCIAL_LINKS.map((link: SocialLink) => (
          <a
            href={link.href}
            class="focus-ring text-base-content/70 hover:text-base-content rounded"
            aria-label={`${t('navigate_to')} ${link.label}`}
            target="_blank"
            rel="noopener noreferrer"
            tabindex="0"
          >
            <link.icon class="h-6 w-6" />
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  footer :global([fill='var(--icon-color)']),
  footer :global([stroke='var(--icon-color)']) {
    --icon-opacity: 0.6;
  }
</style>
