---
import { getLanguageUrl, useI18n } from '@shared/helpers';
import type { NavLink } from '@shared/interfaces';
import { NAVIGATION_I18N } from '../navigation-i18n';
import { NAVIGATION_LINKS } from '../navigation-links';
import CrossIcon from './icons/cross.svg';

const t = useI18n(Astro.url, NAVIGATION_I18N);
const currentPath: string = Astro.url.pathname;
---

<div class="drawer-side z-150">
  <label for="mobile-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
  <div class="menu bg-base-200 min-h-full w-80 p-4">
    <div class="mb-4 flex items-center justify-between">
      <span class="text-lg font-semibold">{t('menu')}</span>
      <label
        id="drawer-close-btn"
        for="mobile-drawer"
        class="btn btn-circle btn-neutral btn-sm focus-ring shadow"
        aria-label={t('close')}
        tabindex="0"
      >
        <div class="h-6 w-6">
          <CrossIcon />
        </div>
      </label>
    </div>
    <ul id="drawer-nav-list" class="space-y-1 text-lg">
      {
        NAVIGATION_LINKS.map((link: NavLink) => {
          const isActive: boolean = currentPath === getLanguageUrl(Astro.url, link.href);

          return (
            <li>
              <a
                href={getLanguageUrl(Astro.url, link.href)}
                class:list={['focus-ring', isActive && 'active']}
                aria-label={`${t('navigate_to')} ${t(link.label)} ${t('page')}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {t(link.label)}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const closeBtn = document.getElementById('drawer-close-btn') as HTMLElement | null;
    const navLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#drawer-nav-list a')
    ) as HTMLAnchorElement[];

    if (closeBtn) {
      closeBtn.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          closeBtn.click();
        } else if (event.key === 'Tab' && event.shiftKey) {
          event.preventDefault();
          navLinks[navLinks.length - 1]?.focus();
        }
      });
    }

    const lastLink = navLinks[navLinks.length - 1];
    if (lastLink) {
      lastLink.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'Tab' && !event.shiftKey) {
          event.preventDefault();
          closeBtn?.focus();
        }
      });
    }
  });
</script>
