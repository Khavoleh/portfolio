---
import { Prose, ProseList, TextSection } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { DATA_COLLECTION_SECTION_I18N } from './data-collection-section-i18n';

const t = useI18n(Astro.url, DATA_COLLECTION_SECTION_I18N);
---

<TextSection title={t('privacy_collect_title')}>
  <Prose muted leading="normal" html={t('privacy_collect_text1')} class="mb-4" />
  <Prose muted leading="normal" html={t('privacy_collect_text2')} class="mb-4" />
  <ProseList items={[t('privacy_collect_technical'), t('privacy_collect_usage'), t('privacy_collect_local')]} />
</TextSection>
