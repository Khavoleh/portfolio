---
import { Prose } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { TextSection } from '@widgets/text-section';
import { EXTERNAL_LINKS_SECTION_I18N } from './external-links-section-i18n';

const t = useI18n(Astro.url, EXTERNAL_LINKS_SECTION_I18N);
---

<TextSection title={t('privacy_links_title')}>
  <Prose muted leading="normal" html={t('privacy_links_text')} class="mb-4" />
</TextSection>
