---
import { EmailLink, Prose, TextSection } from '@shared/components';
import { SOCIALS } from '@shared/constants';
import { useI18n } from '@shared/helpers';
import { CONTACT_SECTION_I18N } from './contact-section-i18n';

const t = useI18n(Astro.url, CONTACT_SECTION_I18N);
---

<TextSection title={t('privacy_contact_title')}>
  <Prose muted leading="normal" html={t('privacy_contact_text1')} class="mb-4" />
  <Prose muted leading="normal">
    <span set:html={t('privacy_contact_text2')} />
    <EmailLink email={SOCIALS.EMAIL} class="font-semibold" />
  </Prose>
</TextSection>
