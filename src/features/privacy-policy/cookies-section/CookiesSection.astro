---
import { Prose } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { ProseList } from '@widgets/prose-list';
import { TextSection } from '@widgets/text-section';
import { COOKIES_SECTION_I18N } from './cookies-section-i18n';

const t = useI18n(Astro.url, COOKIES_SECTION_I18N);
---

<TextSection title={t('privacy_cookies_title')}>
  <Prose muted leading="normal" html={t('privacy_cookies_text')} class="mb-4" />
  <ProseList
    items={[
      t('privacy_cookies_local'),
      t('privacy_cookies_cookies'),
      t('privacy_cookies_no_cookies'),
      t('privacy_cookies_no_ip'),
      t('privacy_cookies_no_cross'),
    ]}
  />
</TextSection>
