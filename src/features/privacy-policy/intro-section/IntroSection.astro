---
import { Prose } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { TextSection } from '@widgets/text-section';
import { INTRO_SECTION_I18N } from './intro-section-i18n';

const t = useI18n(Astro.url, INTRO_SECTION_I18N);
---

<TextSection title={t('privacy_intro_title')}>
  <Prose muted leading="normal" html={t('privacy_intro_text')} class="mb-4" />
</TextSection>
