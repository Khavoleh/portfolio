---
import { Prose, ProseList, TextSection } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { DATA_USE_SECTION_I18N } from './data-use-section-i18n';

const t = useI18n(Astro.url, DATA_USE_SECTION_I18N);
---

<TextSection title={t('privacy_use_title')}>
  <Prose muted leading="normal" html={t('privacy_use_text')} class="mb-4" />
  <ProseList items={[t('privacy_use_monitor'), t('privacy_use_detect'), t('privacy_use_improve')]} />
</TextSection>
