---
import { Heading } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { NOT_FOUND_I18N } from './not-found-i18n';

const t = useI18n(Astro.url, NOT_FOUND_I18N);
---

<section class="bg-base-100 text-center">
  <Heading
    level={1}
    weight="extrabold"
    center
    class="animate-bounce-slow mb-8 font-mono text-[8rem] leading-none md:text-[16rem] lg:text-[20rem] xl:text-[24rem]"
    >404
  </Heading>

  <Heading level={2} size="3xl" center class="mb-6 md:text-4xl">{t('not_found_title')}</Heading>
</section>

<style>
  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }
</style>
