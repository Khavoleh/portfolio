---
import { useI18n } from '@shared/helpers';
import { NOT_FOUND_I18N } from './not-found-i18n';

const t = useI18n(Astro.url, NOT_FOUND_I18N);
---

<section class="bg-base-100 text-center">
  <h1
    class="animate-bounce-slow text-primary mb-8 text-[8rem] leading-none font-extrabold md:text-[16rem] lg:text-[20rem] xl:text-[24rem]"
  >
    404
  </h1>

  <h2 class="text-base-content mb-6 text-3xl font-bold md:text-4xl">{t('not_found_title')}</h2>
</section>

<style>
  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }
</style>
