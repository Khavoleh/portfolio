---
import { useI18n } from '@shared/helpers';
import type { SocialLink } from '@shared/interfaces';
import { SOCIAL_LINKS } from './social-links';
import { SOCIAL_LINKS_I18N } from './social-links-i18n';

const t = useI18n(Astro.url, SOCIAL_LINKS_I18N);
---

<section class="mb-16">
  <h2 class="text-base-content mb-8 text-center text-3xl font-bold">{t('socialLinks_title')}</h2>

  <div class="mx-auto flex max-w-2xl flex-wrap justify-center gap-6">
    {
      SOCIAL_LINKS.map((link: SocialLink) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="card bg-base-200 border-base-300 focus-ring flex flex-col items-center border p-8 shadow-lg transition-all duration-200 hover:scale-105 hover:shadow-xl"
          aria-label={link.ariaKey ? t(link.ariaKey) : undefined}
          tabindex="0"
        >
          <link.icon class="text-primary mb-4 h-16 w-16" />
          <span class="text-base-content text-lg font-semibold">{link.label}</span>
        </a>
      ))
    }
  </div>

  <p
    class="text-base-content mx-auto mt-8 max-w-2xl text-center leading-relaxed"
    set:html={t('socialLinks_description')}
  />
</section>
