---
import { Button, Heading, Prose } from '@shared/components';
import { PAGE_URLS } from '@shared/constants';
import { getLanguageUrl, useI18n } from '@shared/helpers';
import { ViewCv } from '@widgets/view-cv';
import { CALL_TO_ACTION_I18N } from './call-to-action-i18n';

const t = useI18n(Astro.url, CALL_TO_ACTION_I18N);
---

<section class="text-center">
  <Heading level={2} center class="mb-4">{t('cta_title')}</Heading>
  <Prose center class="mx-auto mb-8 max-w-2xl">
    {t('cta_description')}
  </Prose>

  <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
    <ViewCv />

    <Button href={getLanguageUrl(Astro.url, PAGE_URLS.EXPERIENCE)} variant="secondary" outline>
      {t('cta_button_experience')}
    </Button>
  </div>
</section>
