---
import { Card, Heading } from '@shared/components';
import { SOCIALS } from '@shared/constants';
import { useI18n } from '@shared/helpers';
import { EmailLink } from '@widgets/email-link';
import { DIRECT_CONTACT_I18N } from './direct-contact-i18n';
import { getUkraineTimezone } from './get-ukraine-timezone';
import EmailIcon from './icons/email.svg';
import GeolocationIcon from './icons/geolocation.svg';
import MessengerIcon from './icons/messenger.svg';

const iconClasses = 'mb-4 h-12 w-12 text-base-content icon-muted';
const cardClasses = 'flex w-64 flex-col items-center text-center';
const t = useI18n(Astro.url, DIRECT_CONTACT_I18N);
---

<section class="mb-16">
  <Heading level={2} size="3xl" center class="mb-8">{t('directContact_title')}</Heading>

  <div class="mx-auto flex flex-wrap justify-center gap-6">
    <Card hover="scale" class={cardClasses}>
      <EmailIcon class={iconClasses} />
      <Heading level={3} weight="semibold" class="mb-2">{t('directContact_email_title')}</Heading>
      <EmailLink email={SOCIALS.EMAIL} />
    </Card>

    <Card hover="scale" class={cardClasses}>
      <MessengerIcon class={iconClasses} />
      <Heading level={3} weight="semibold" class="mb-2">Telegram</Heading>
      <a
        href={SOCIALS.TELEGRAM}
        target="_blank"
        rel="noopener noreferrer"
        class="link link-violet focus-ring rounded transition-all duration-200"
        tabindex="0"
      >
        @khavol
      </a>
    </Card>

    <Card hover="scale" class={cardClasses}>
      <GeolocationIcon class={iconClasses} />
      <Heading level={3} weight="semibold" class="mb-2">{t('directContact_location_title')}</Heading>
      <p class="text-base-content/80">{t('directContact_location_city')}</p>
      <p id="ukraine-timezone" class="text-base-content/80 text-sm">
        {getUkraineTimezone()}
      </p>
    </Card>
  </div>
</section>

<script>
  import { getUkraineTimezone } from './get-ukraine-timezone';

  const updateTimezone = () => {
    const tzElement = document.getElementById('ukraine-timezone');
    if (tzElement) {
      tzElement.textContent = getUkraineTimezone();
    }
  };

  updateTimezone();

  document.addEventListener('astro:page-load', updateTimezone);
</script>
