---
import GitHubIcon from '@assets/github.svg';
import { ButtonLink } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { GITHUB_BUTTON_I18N } from './github-button-i18n';

interface Props {
  url: string;
}

const { url } = Astro.props;
const t = useI18n(Astro.url, GITHUB_BUTTON_I18N);
---

<div class="flex justify-center">
  <ButtonLink href={url} target="_blank" rel="noopener noreferrer">
    <GitHubIcon class="mr-2 h-6 w-6" fill="var(--color-primary-content)" />
    {t('github_button')}
  </ButtonLink>
</div>
