---
import { Card, IconCard, SectionHeader } from '@shared/components';
import { useI18n } from '@shared/helpers';
import GitHubButton from '../components/github-button/GitHubButton.astro';
import TechStack from '../components/tech-stack/TechStack.astro';
import type { ProjectSection } from '../project-item';
import { FORGE_MOCK } from './constants';
import { FORGE_MOCK_PROJECT_I18N } from './forge-mock-project-i18n';
import ForgeMockIcon from './icons/forge-mock.svg';

const t = useI18n(Astro.url, FORGE_MOCK_PROJECT_I18N);
---

<Card as="section" padding="xl" shadow="2xl" class="mb-12">
  <SectionHeader title={t(FORGE_MOCK.title)} description={t(FORGE_MOCK.description)} Icon={ForgeMockIcon} />

  <div class="mb-8 grid gap-8 md:grid-cols-2">
    {
      FORGE_MOCK.sections.map((section: ProjectSection) => (
        <IconCard Icon={section.icon} title={t(section.title)} details={section.details.map((d) => t(d))} />
      ))
    }
  </div>

  <TechStack skills={FORGE_MOCK.skills} />

  <GitHubButton url="https://github.com/forge-mock" />
</Card>
