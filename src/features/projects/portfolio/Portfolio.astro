---
import LogoIcon from '@assets/logo.svg';
import { Card, Heading, IconCard, Prose, SectionHeader } from '@shared/components';
import { useI18n } from '@shared/helpers';
import GitHubButton from '../components/github-button/GitHubButton.astro';
import TechStack from '../components/tech-stack/TechStack.astro';
import type { ProjectSection } from '../project-item';
import { PERFORMANCE_METRICS } from './constants/performance-metrics';
import { PORTFOLIO } from './constants/portfolio';
import { PORTFOLIO_PROJECT_I18N } from './portfolio-project-i18n';

const t = useI18n(Astro.url, PORTFOLIO_PROJECT_I18N);
---

<Card as="section" padding="xl" shadow="2xl" class="mb-12">
  <SectionHeader title={t(PORTFOLIO.title)} description={t(PORTFOLIO.description)} Icon={LogoIcon} />

  <div class="mb-8 grid gap-8 md:grid-cols-2">
    {
      PORTFOLIO.sections.map((section: ProjectSection) => (
        <IconCard Icon={section.icon} title={t(section.title)} details={section.details.map((d) => t(d))} />
      ))
    }
  </div>

  <div class="mb-8">
    <Heading level={3} center class="mb-4">{t('portfolio_performance_title')}</Heading>
    <div class="p-6">
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        {
          PERFORMANCE_METRICS.map((metric: string) => (
            <div class="text-center">
              <p class="text-success mb-2 text-4xl font-bold">100</p>
              <p class="text-base-content/80 text-sm font-semibold">{t(metric)}</p>
            </div>
          ))
        }
      </div>
      <Prose muted size="sm" center class="mt-4 italic">
        {t('portfolio_performance_note')}
      </Prose>
    </div>
  </div>

  <TechStack skills={PORTFOLIO.skills} />

  <GitHubButton url="https://github.com/Khavoleh/portfolio" />
</Card>
