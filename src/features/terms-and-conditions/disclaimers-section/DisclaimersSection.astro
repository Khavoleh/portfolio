---
import { Prose } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { ProseList } from '@widgets/prose-list';
import { TextSection } from '@widgets/text-section';
import { DISCLAIMERS_SECTION_I18N } from './disclaimers-section-i18n';

const t = useI18n(Astro.url, DISCLAIMERS_SECTION_I18N);
---

<TextSection title={t('terms_disclaimers_title')}>
  <Prose muted leading="normal" html={t('terms_disclaimers_text')} class="mb-4" />
  <ProseList items={[t('terms_disclaimers_informational'), t('terms_disclaimers_no_guarantee')]} />
</TextSection>
