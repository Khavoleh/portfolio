---
import { Prose, ProseList, TextSection } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { INTELLECTUAL_PROPERTY_SECTION_I18N } from './intellectual-property-section-i18n';

const t = useI18n(Astro.url, INTELLECTUAL_PROPERTY_SECTION_I18N);
---

<TextSection title={t('terms_intellectual_title')}>
  <Prose muted leading="normal" html={t('terms_intellectual_text')} class="mb-4" />
  <ProseList items={[t('terms_intellectual_code'), t('terms_intellectual_restrictions')]} />
</TextSection>
