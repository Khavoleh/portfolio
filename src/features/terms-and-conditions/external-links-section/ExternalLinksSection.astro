---
import { Prose, TextSection } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { EXTERNAL_LINKS_SECTION_I18N } from './external-links-section-i18n';

const t = useI18n(Astro.url, EXTERNAL_LINKS_SECTION_I18N);
---

<TextSection title={t('terms_links_title')}>
  <Prose muted leading="normal" html={t('terms_links_text1')} class="mb-4" />
  <Prose muted leading="normal" html={t('terms_links_text2')} class="mb-4" />
</TextSection>
