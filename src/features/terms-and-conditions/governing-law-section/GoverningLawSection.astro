---
import { Prose } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { TextSection } from '@widgets/text-section';
import { GOVERNING_LAW_SECTION_I18N } from './governing-law-section-i18n';

const t = useI18n(Astro.url, GOVERNING_LAW_SECTION_I18N);
---

<TextSection title={t('terms_governing_title')}>
  <Prose muted leading="normal" html={t('terms_governing_text')} class="mb-4" />
</TextSection>
