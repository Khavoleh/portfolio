---
import { Prose, TextSection } from '@shared/components';
import { useI18n } from '@shared/helpers';
import { ACCEPTANCE_SECTION_I18N } from './acceptance-section-i18n';

const t = useI18n(Astro.url, ACCEPTANCE_SECTION_I18N);
---

<TextSection title={t('terms_acceptance_title')}>
  <Prose muted leading="normal" html={t('terms_acceptance_text')} class="mb-4" />
</TextSection>
