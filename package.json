{
  "name": "portfolio",
  "type": "module",
  "version": "1.2.21",
  "repository": {
    "type": "git",
    "url": "https://github.com/Khavoleh/portfolio"
  },
  "scripts": {
    "dev": "astro dev --config astro.config.local.ts",
    "build": "astro build",
    "preview": "astro build --config astro.config.local.ts && astro preview --config astro.config.local.ts",
    "astro": "astro",
    "prettier": "prettier . --write",
    "lint": "biome check",
    "unit": "vitest run",
    "e2e": "playwright test",
    "depcruise": "depcruise src",
    "prepare": "lefthook install",
    "validate": "astro build && pnpm unit && pnpm lint && pnpm prettier --check && pnpm astro-check && pnpm depcruise"
  },
  "dependencies": {
    "@astrojs/vercel": "10.0.8",
    "astro": "6.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/node": "10.1.2",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.11.3",
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "1.60.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@tailwindcss/vite": "4.3.0",
    "daisyui": "5.5.20",
    "dependency-cruiser": "17.4.2",
    "globals": "17.6.0",
    "lefthook": "2.1.9",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "schema-dts": "2.0.0",
    "semantic-release": "25.0.3",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.0",
    "vitest": "4.1.7"
  }
}
