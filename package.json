{
  "name": "portfolio",
  "type": "module",
  "version": "1.2.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Khavoleh/portfolio"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build --config astro.config.local.ts && astro preview --config astro.config.local.ts",
    "astro": "astro",
    "prettier": "prettier . --write",
    "lint": "biome check",
    "test": "vitest run",
    "depcruise": "depcruise src",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/vercel": "10.0.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "astro": "6.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.7",
    "@astrojs/node": "10.0.2",
    "@astrojs/sitemap": "3.7.1",
    "@biomejs/biome": "2.4.7",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@tailwindcss/vite": "4.2.1",
    "daisyui": "5.5.19",
    "dependency-cruiser": "17.3.9",
    "globals": "17.4.0",
    "lefthook": "2.1.4",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "schema-dts": "1.1.5",
    "semantic-release": "25.0.3",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "vitest": "4.1.0"
  }
}
