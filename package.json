{
  "name": "portfolio",
  "type": "module",
  "version": "1.2.21",
  "repository": {
    "type": "git",
    "url": "https://github.com/Khavoleh/portfolio"
  },
  "scripts": {
    "dev": "astro dev --config astro.config.local.ts",
    "build": "astro build",
    "preview": "astro build --config astro.config.local.ts && astro preview --config astro.config.local.ts",
    "astro": "astro",
    "prettier": "prettier . --write",
    "lint": "biome check",
    "unit": "vitest run",
    "e2e": "playwright test",
    "depcruise": "depcruise src",
    "prepare": "lefthook install",
    "validate": "astro build && pnpm unit && pnpm lint && pnpm prettier --check && pnpm astro-check && pnpm depcruise"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.1",
    "astro": "7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.2",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.19",
    "dependency-cruiser": "18.2.0",
    "globals": "17.11.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "schema-dts": "2.0.0",
    "semantic-release": "25.0.9",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
