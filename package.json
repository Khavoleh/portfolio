{
  "name": "portfolio",
  "type": "module",
  "version": "1.2.16",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Khavoleh/portfolio"
  },
  "scripts": {
    "dev": "astro dev --config astro.config.local.ts",
    "build": "astro build",
    "preview": "astro build --config astro.config.local.ts && astro preview --config astro.config.local.ts",
    "astro": "astro",
    "prettier": "prettier . --write",
    "lint": "biome check",
    "unit": "vitest run",
    "e2e": "playwright test",
    "depcruise": "depcruise src",
    "prepare": "lefthook install",
    "validate": "astro build && pnpm unit && pnpm e2e && pnpm lint && pnpm prettier --check && pnpm astro-check && pnpm depcruise"
  },
  "dependencies": {
    "@astrojs/vercel": "10.0.3",
    "astro": "6.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/node": "10.0.4",
    "@astrojs/sitemap": "3.7.2",
    "@axe-core/playwright": "4.11.1",
    "@biomejs/biome": "2.4.9",
    "@playwright/test": "1.58.2",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@tailwindcss/vite": "4.2.2",
    "daisyui": "5.5.19",
    "dependency-cruiser": "17.3.10",
    "globals": "17.4.0",
    "lefthook": "2.1.4",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "schema-dts": "2.0.0",
    "semantic-release": "25.0.3",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.2",
    "vitest": "4.1.2"
  }
}
